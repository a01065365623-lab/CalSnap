GEMINI_API_KEY=your-gemini-api-key
PROXY_API_KEY=change-me
# Railway Postgres 플러그인을 붙이면 자동 주입된다. 없으면 메모리 카운터로 대체(재시작 시 초기화).
DATABASE_URL=postgresql://user:pass@host:5432/railway
# 기기당 하루 허용 횟수(KST 자정 초기화). 0 이하면 무제한.
DAILY_LIMIT_PHOTO=3
DAILY_LIMIT_TEXT=20
# 구독자용 사진 한도(구독 기능 연결 전, 아직 미사용)
DAILY_LIMIT_PHOTO_PREMIUM=30
CACHE_MAX_ENTRIES=5000
PORT=8080
